{
    "name": "@mailcraft/node",
    "version": "0.1.0",
    "description": "Official Node.js SDK for the MailCraft email API — transactional email, SMTP relay, campaigns, automations, and contacts.",
    "keywords": [
        "email",
        "email-api",
        "mailcraft",
        "smtp",
        "transactional-email"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/mail-craft/mailcraft-node"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.5.0",
        "vitest": "^2.0.0"
    },
    "engines": {
        "node": ">=18"
    }
}
